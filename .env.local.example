# Which business THIS deployment serves — the businesses.id row it is pinned
# to. REQUIRED: every query, token lookup, email and settings read is scoped to
# it, and the app refuses to run without it (never silently another business).
#   Uinta:     ccb6176e-d677-47b2-896d-99118193237f
#   Camelback: d474ac66-dfbc-47c7-b827-dbff9431db89
BUSINESS_ID=

# Supabase — same project as the field app (Project A)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Every route in this app runs server-side with this key and it
# BYPASSES RLS entirely — each route is responsible for its own token check.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — test-mode keys until launch. No webhook secret: this app has no
# Stripe webhook (card SetupIntents confirm synchronously; /api/payment/finalize
# re-retrieves from Stripe as the source of truth).
STRIPE_SECRET_KEY=
# Publishable key is safe to expose to the browser — Stripe Elements needs it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — RESEND_FROM_EMAIL must be a verified sender in the Resend account.
# (businesses.from_email, when set, takes precedence; the display name always
# comes from businesses.from_name.)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Kit (kit.com) — the opt-in "daily quotes" email list on the booking form.
# MARKETING only, completely separate from Resend (transactional email). v4 API
# key, sent as the X-Kit-Api-Key header. Leave empty to disable the opt-in call
# entirely — the checkbox still renders and bookings are unaffected.
KIT_API_KEY=

# Google Maps Geocoding — server-only, never exposed to the client.
GOOGLE_MAPS_API_KEY=

# Google Routes API (Compute Route Matrix), NOT the legacy Distance Matrix
# API — used by the geographic clustering feature for real driving time on
# the booking/reschedule slot picker. Server-only. This is a SEPARATE key
# from GOOGLE_MAPS_API_KEY above (different API), and it is SHARED with
# uinta-field-app's own copy of this variable — same literal value in both
# repos' env, one Google Cloud Console budget alert covering both apps'
# combined spend. Do not create a second key or a second alert.
GOOGLE_ROUTE_MATRIX_API_KEY=

# Google Places Autocomplete (address field on the booking form) — this one
# DOES run in the browser, so it must be a separate key from
# GOOGLE_MAPS_API_KEY above, restricted in Google Cloud Console to:
#   - HTTP referrers: this app's domain(s) (and localhost:3000 for dev)
#   - APIs: Places API (New) + Maps JavaScript API
# Never reuse the server-only geocoding key here — an unrestricted browser key
# is usable by anyone who views the page source.
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Live Google reviews on the home page (lib/googleReviews.ts) — server-only.
# A SEPARATE key: the browser key above is HTTP-referrer restricted and Google
# rejects it from a server (API_KEY_HTTP_REFERRER_BLOCKED). Restrict this one
# by API only (Places API (New)) — Netlify functions have no fixed IPs.
# Fetched live (Google's terms forbid caching reviews) whenever a visitor
# scrolls near the pricing section, so set a Cloud Console daily quota and a
# budget alert for it — Place Details with reviews is billed past 1,000/month. Leave either value
# blank and the reviews block simply doesn't render.
GOOGLE_PLACES_REVIEWS_API_KEY=
# The Google Business Profile's place ID (ChIJ...), not the Maps CID.
GOOGLE_PLACE_ID=

# Bearer token for POST /api/import/payment-setup-email (Project A's import
# script authenticates with it). Any long random string; set the same value
# in Project A's env.
IMPORT_API_SECRET=

# Public base URL for magic-link URLs in emails. LEAVE EMPTY until a real
# domain is live — links then derive from the request host (so local dev on
# any port just works). Set to the real https://... domain once it exists.
APP_BASE_URL=

# Microsoft Clarity project ID (session recordings + heatmaps). Loaded only in
# production builds, only on the marketing pages and /book. Leave unset/commented
# in dev; set in Netlify. Before enabling: Clarity dashboard -> Settings ->
# Masking -> Strict (manual step; masking changes aren't retroactive).
# NEXT_PUBLIC_CLARITY_ID=yr73hg7gcb

# Google Ads base tag ID (AW-...). Loaded only in production builds, only on the
# marketing pages and /book. Leave unset/commented in dev; set in Netlify.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18488012241

# Anthropic — server-only, powers the marketing-site chat widget's API route
# (app/api/chat). Never exposed to the browser. Model is claude-haiku-4-5.
# Leave empty to disable the widget: the launcher still renders but the route
# returns a "call or text us" message instead of an answer.
ANTHROPIC_API_KEY=

# Project A's (uinta-field-app's) base URL — this app's /api/payment/
# finalize-backlog route POSTs to {FIELD_APP_BASE_URL}/api/internal/charge-job
# to charge a backlog job's card once it's saved. Reverse direction of
# APP_BASE_URL above.
FIELD_APP_BASE_URL=

# Bearer token for the same call — set the SAME value in Project A's env (as
# CHARGE_JOB_API_SECRET). Scoped to that one endpoint, mirroring
# IMPORT_API_SECRET's pattern in reverse.
CHARGE_JOB_API_SECRET=

# Bearer token for POST /api/internal/owner-reschedule-notify — Project A's
# field-app job edit page authenticates with it (server-to-server) after the
# owner/tech changes a job's date or arrival window directly, so the customer
# still gets an updated .ics confirmation email. Any long random string; set
# the same value in Project A's env (as OWNER_RESCHEDULE_API_SECRET).
OWNER_RESCHEDULE_API_SECRET=

# Bearer token for POST /api/internal/cluster-consent-notify — Project A
# authenticates with it (server-to-server) after the owner approves a
# geographic-clustering suggestion for an already-scheduled job, so this app
# can send the customer their consent-request email(s). Any long random
# string; set the same value in Project A's env (as
# CLUSTERING_CONSENT_API_SECRET).
CLUSTERING_CONSENT_API_SECRET=
